# ==============================================================================
# Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to '.env' if your workflow requires local environment settings.
# IMPORTANT: Never commit actual '.env' files or sensitive credentials to Git!
# ==============================================================================

# Application Environment (development, testing, production)
APP_ENV=development

# MATLAB Engine / Runtime Options (Optional)
MATLAB_LOG_LEVEL=INFO

# External Cloud / Storage / API Configuration (Optional)
# If integrating with remote datasets, cloud storage, or external APIs:
# CLOUD_STORAGE_BUCKET=
# CLOUD_API_KEY=your_api_key_here
# CLOUD_API_SECRET=your_api_secret_here
